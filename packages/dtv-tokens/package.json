{
  "name": "@dtv/tokens",
  "version": "0.1.0",
  "description": "DTV Design System tokens (imported into Prism System)",
  "type": "module",
  "main": "./dist/js/tokens.js",
  "types": "./dist/js/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "import": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/variables.css",
    "./css/dark": "./dist/css/variables-dark.css",
    "./primitives": "./src/primitives/tokens.json",
    "./semantic/light": "./src/semantic/light.json",
    "./semantic/dark": "./src/semantic/dark.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs"
  }
}
